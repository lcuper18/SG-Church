# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

#################################################
# DJANGO
#################################################

DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Environment: development | production | test
DJANGO_SETTINGS_MODULE=sg_church.settings.local

#################################################
# DATABASE
#################################################

# Used by sg_church.settings.base/production (Postgres, required there —
# there is no insecure default, the app refuses to start without these).
DATABASE_NAME=sgchurch
DATABASE_USER=sgchurch
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Standalone (single-church, SQLite) installs use this instead — see
# sg_church.settings.standalone. Leave unset to default to a local
# db.sqlite3 file.
# DATABASE_URL=sqlite:///db.sqlite3

#################################################
# REDIS / CELERY
#################################################

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

#################################################
# AUTHENTICATION
#################################################

# Django Auth (built-in)
# Use strong random secret in production
AUTH_SECRET_KEY=your-auth-secret-key-change-in-production

# django-allauth (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# OAuth Providers (Optional)
SOCIALAUTH_GOOGLE_OAUTH2_KEY=
SOCIALAUTH_GOOGLE_OAUTH2_SECRET=

#################################################
# EMAIL NOTIFICATIONS
#################################################

# The system sends: new-account and password-reset links, donation receipts,
# and event/course/certificate confirmations. Any SMTP provider works (Gmail,
# Brevo, Mailgun, SendGrid, the church's own server). Without EMAIL_HOST the
# messages are only printed to the log, so nothing breaks on a fresh install.
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Absolute URL used for links in e-mails sent outside a web request (optional)
SITE_URL=https://app.yourdomain.com
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Example: SendGrid
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=

# Example: AWS SES
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# AWS_SES_REGION=us-east-1

#################################################
# SMS NOTIFICATIONS
#################################################

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

#################################################
# PAYMENT PROCESSING (Stripe)
#################################################

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Connect (for multi-tenant payments)
STRIPE_CONNECT_ENABLED=True

#################################################
# FILE STORAGE
#################################################

# AWS S3
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# Or use local storage (development)
# DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
# MEDIA_ROOT=media/

#################################################
# MONITORING
#################################################

# Sentry (Error tracking)
SENTRY_DSN=

#################################################
# SECURITY
#################################################

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Production security (uncomment for production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

#################################################
# MULTI-TENANCY
#################################################

# Tenant resolution: subdomain | path
TENANT_RESOLUTION_STRATEGY=subdomain
BASE_DOMAIN=localhost:8000

#################################################
# LOGGING
#################################################

LOG_LEVEL=info

#################################################
# TESTING
#################################################

# Test database (separate)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sgchurch_test

#################################################
# OPTIONAL
#################################################

# Slack webhook for admin alerts
SLACK_WEBHOOK_URL=

#################################################
# NOTES
#################################################

# 1. Copy this file to .env for local development
# 2. For production, set these in your hosting provider
# 3. NEVER commit .env to version control
# 4. Use strong, random values for all secrets
# 5. Rotate secrets regularly

#################################################
# BACKUPS (nightly, see docs/DEPLOYMENT.md#backups)
#################################################
# BACKUP_ENABLED=true
# BACKUP_HOUR=3
# BACKUP_KEEP=14
# Copy every backup to an S3-compatible bucket as well (recommended):
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_S3_PREFIX=sg-church
# (uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above)

#################################################
# "SUPPORT THE DEVELOPMENT" PAYPAL BUTTON (footer)
#################################################
# Defaults point to the developer's account. Set PAYPAL_SUPPORT_BUTTON_ID= (empty)
# to hide the button on your installation.
# PAYPAL_SUPPORT_CLIENT_ID=
# PAYPAL_SUPPORT_BUTTON_ID=

#################################################
# TRASH
#################################################
# Days a deleted record stays in the trash before it is removed for good
# TRASH_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# PROCESSES (optional; the defaults suit a 2 vCPU / 4 GB server)
# ---------------------------------------------------------------------------
# gunicorn: hosted setup = 3 workers x 2 threads; standalone (SQLite) = 1 worker x 4 threads.
# WEB_CONCURRENCY=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60
# GUNICORN_MAX_REQUESTS=1000
# Celery task processes (e-mails, reminders, backups).
# CELERY_CONCURRENCY=2
